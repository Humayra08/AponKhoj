# Copy this file to .env (at repo root) and fill in real values.
# This file is read by docker-compose.yml for the db/phpmyadmin/app services.
# The actual application secrets (JWT, mail, Cloudinary, etc.) live in
# server/.env — see server/.env.example for that template.

APP_URL=http://localhost

DB_DATABASE=aponkhoj
DB_USERNAME=aponkhoj_user
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_me
